# Database (required for EI)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Rate limiting (optional; when missing, rate limit is no-op)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron routes (Vercel cron sends Authorization: Bearer <CRON_SECRET> or x-cron-secret header)
CRON_SECRET=

# Ops routes (timeline, future backfill) — platform ops only
OPS_API_KEY=
OPS_DEV_BYPASS_SECRET=
